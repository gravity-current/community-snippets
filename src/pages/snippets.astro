---
import EntryRow from '../components/EntryRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntriesByType } from '../lib/entries';

const entries = await getEntriesByType('snippet');
---

<BaseLayout title="Snippets" description="Small pieces of code for Synesthesia." activeNav="snippets">
  <div class="content-wide">
    <h1 class="page-title">Snippets</h1>
    <p class="page-subhead">Small pieces of code for Synesthesia.</p>
    <div class="count-line">{entries.length} snippets · newest first</div>

    {entries.length > 0 ? (
      <div class="row-list">
        {entries.map((entry) => (
          <EntryRow entry={entry} />
        ))}
      </div>
    ) : (
      <div class="empty-state">Nothing here yet. <a href="/contribute">Submit one.</a></div>
    )}
  </div>
</BaseLayout>
