---
import EntryRow from '../components/EntryRow.astro';
import SectionHead from '../components/SectionHead.astro';
import TypeTag from '../components/TypeTag.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllEntries, getFeaturedEntries, typeAccentVar } from '../lib/entries';

const entries = await getAllEntries();
const featured = getFeaturedEntries(entries);
const lead = featured.find((entry) => entry.type === 'write-up') ?? featured[0];
const secondary = featured.filter((entry) => entry.id !== lead?.id).slice(0, 3);
const recent = entries.slice(0, 5);
---

<BaseLayout title="fun.syn.live" description="Useful functions, snippets, and field notes shared by the Synesthesia community.">
  <div class="content-wide">
    <div class="home-intro">
      <h1 class="page-title home-title">
        <span class="home-title__line"><span class="home-title__offset">Syn</span>esthesia</span>
        <span class="home-title__line"><span class="home-title__offset">Fun</span>ctions</span>
      </h1>
      <p class="page-subhead home-subhead">Community-submitted code for Synesthesia.</p>

      <div class="home-actions">
        <a class="button button-primary" href="/browse">Browse all <span aria-hidden="true">→</span></a>
        <nav class="home-jumps" aria-label="Browse by entry type">
          <span class="home-jumps__label">jump to</span>
          <a href="/functions"><span class="type-dot type-function" aria-hidden="true"></span>functions</a>
          <a href="/snippets"><span class="type-dot type-snippet" aria-hidden="true"></span>snippets</a>
          <a href="/write-ups"><span class="type-dot type-write-up" aria-hidden="true"></span>write-ups</a>
        </nav>
      </div>
    </div>

    <section class="section">
      <button class="search-form search-form--trigger js-open-search" type="button">
        <span class="search-form__icon">⌕</span>
        <span class="search-form__placeholder">search functions, tags, authors (try palette or beat)</span>
        <span class="search-form__key">?</span>
      </button>
      <p class="search-shortcut-hint"><span>Shift + /</span> to search from anywhere <span aria-hidden="true">↖</span></p>
    </section>

    {lead && (
      <section class="section">
        <SectionHead title="Featured" />

        <div class="featured-grid">
          <article class="featured-card featured-card--lead" style={`--featured-accent: ${typeAccentVar[lead.type]};`}>
            <div style="display:flex;align-items:center;gap:12px;">
              <TypeTag type={lead.type} lang={lead.lang} />
            </div>

            {lead.cover && (
              <a class="preview-slot" href={lead.href}>
                <img class="preview-slot__img" src={lead.cover} alt="" loading="lazy" />
              </a>
            )}

            <a class="featured-title" href={lead.href}>{lead.title}<span class="featured-title__arrow" aria-hidden="true">→</span></a>
            <p class="featured-copy">{lead.excerpt ?? lead.summary}</p>

            <div class="featured-meta" style="display:flex;align-items:center;gap:10px;">
              <strong>@{lead.submittedBy}</strong> · {lead.dateLabel}{lead.readTime ? ` · ${lead.readTime}` : ''}
              <a href={lead.href} style="margin-left:auto;color:var(--orange);font-weight:700;">read →</a>
            </div>
          </article>

          <div class="featured-stack">
            {secondary.map((entry) => (
              <article class="featured-card featured-card--mini" style={`--featured-accent: ${typeAccentVar[entry.type]};`}>
                <TypeTag type={entry.type} lang={entry.lang} />
                <a class="featured-mini__title" href={entry.href}>{entry.title}<span class="featured-title__arrow" aria-hidden="true">→</span></a>
                <p class="featured-mini__copy">{entry.summary}</p>
                <div class="featured-mini__meta">@{entry.submittedBy} · {entry.dateLabel}</div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <SectionHead title="Recent" actionLabel="view all →" actionHref="/browse" />
      <div class="row-list">
        {recent.map((entry) => (
          <EntryRow entry={entry} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
