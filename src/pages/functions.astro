---
import EntryRow from '../components/EntryRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntriesByType } from '../lib/entries';

const entries = await getEntriesByType('function');
---

<BaseLayout title="Functions" description="Reusable functions for Synesthesia." activeNav="functions">
  <div class="content-wide">
    <h1 class="page-title">Functions</h1>
    <p class="page-subhead">Reusable functions for Synesthesia.</p>
    <div class="count-line">{entries.length} functions · newest first</div>

    {entries.length > 0 ? (
      <div class="row-list">
        {entries.map((entry) => (
          <EntryRow entry={entry} />
        ))}
      </div>
    ) : (
      <div class="empty-state">Nothing here yet. <a href="/contribute">Submit one.</a></div>
    )}
  </div>
</BaseLayout>
